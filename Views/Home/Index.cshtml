@model IEnumerable<BingoGame.Models.QuestionItem>
@inject BingoGame.Services.SettingsService SettingsService

@{
    ViewData["Title"] = "Bingo Game";
    var bgImages = SettingsService.GetBackgroundImages();
}

<style>
    body {
        background-color: #1e1e2f;
        color: white;
    }
    .bingo-board {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 15px;
        max-width: 800px;
        margin: 0 auto;
        padding: 20px;
    }
    .bingo-cell {
        background: linear-gradient(135deg, #6e8efb, #a777e3);
        border-radius: 12px;
        aspect-ratio: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 3rem;
        font-weight: bold;
        cursor: pointer;
        box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        transition: transform 0.2s, box-shadow 0.2s;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
    }
    .bingo-cell:hover {
        transform: translateY(-5px) scale(1.02);
        box-shadow: 0 8px 25px rgba(167, 119, 227, 0.5);
    }
    .bingo-cell.opened {
        background: linear-gradient(135deg, #2b5876, #4e4376);
        color: #999;
        text-shadow: none;
        pointer-events: none; /* Can't click again if correct */
    }
    .modal-content {
        background-color: #2a2a3c;
        color: white;
        border: 1px solid #444;
        border-radius: 12px;
    }
    .modal-header {
        border-bottom: 1px solid #444;
    }
    .question-text {
        font-size: 3rem;
        line-height: 1.6;
        margin-bottom: 30px;
        font-weight: bold;
    }
    .option-btn {
        font-size: 2rem;
        text-align: left;
        padding: 20px 30px;
        margin-bottom: 15px;
        border-radius: 15px;
        border: 2px solid #555;
        background-color: #333;
        color: white;
        transition: all 0.2s;
        cursor: pointer;
        width: 100%;
        display: block;
    }
    .option-btn:hover {
        background-color: #444;
        border-color: #777;
    }
    .option-btn.correct {
        background-color: #2e7d32 !important;
        border-color: #4caf50 !important;
        color: white !important;
    }
    .option-btn.wrong {
        background-color: #c62828 !important;
        border-color: #ef5350 !important;
        color: white !important;
        animation: shake 0.4s;
    }
    .feedback-text {
        font-size: 2.5rem;
        font-weight: bold;
        display: none;
        margin-top: 20px;
        text-align: center;
    }
    @@keyframes shake {
        0% { transform: translateX(0); }
        25% { transform: translateX(-10px); }
        50% { transform: translateX(10px); }
        75% { transform: translateX(-10px); }
        100% { transform: translateX(0); }
    }
</style>

<div id="bg-container" style="position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: -1000; overflow: hidden; background-color: #1e1e2f;"></div>

<div class="text-center mt-4 mb-4">
    <h1 class="display-4 fw-bold text-white" style="text-shadow: 2px 2px 8px rgba(0,0,0,0.8);">BINGO GAME</h1>
</div>

<div class="bingo-board">
    @foreach (var item in Model)
    {
        <div class="bingo-cell" 
             data-id="@item.Id" 
             data-question="@item.QuestionText" 
             data-opt-a="@item.OptionA"
             data-opt-b="@item.OptionB"
             data-opt-c="@item.OptionC"
             data-opt-d="@item.OptionD"
             data-correct="@item.CorrectOption"
             onclick="openQuestion(this)">
            @item.Id
        </div>
    }
</div>

<!-- Question Modal -->
<div class="modal fade" id="questionModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
  <div class="modal-dialog modal-dialog-centered modal-xl" style="max-width: 90vw;">
    <div class="modal-content">
      <div class="modal-header align-items-center">
        <h5 class="modal-title display-5 fw-bold text-warning" id="modalTitle">Câu hỏi</h5>
        <div class="d-flex align-items-center">
            <button id="toggleAudioBtn" class="btn btn-outline-light me-3" style="border:none; font-size: 1.8rem; background:transparent; padding: 0;" onclick="toggleBackgroundAudio()" title="Bật/Tắt âm thanh">
                <span id="audioIcon">🔊</span>
            </button>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
      </div>
      <div class="modal-body p-5">
        <div class="question-text text-start" id="modalQuestionText"></div>
        
        <div class="options-container mt-4">
            <button class="option-btn" id="btnA" onclick="checkAnswer('A')"><span class="fw-bold text-warning me-3">A.</span><span id="textA"></span></button>
            <button class="option-btn" id="btnB" onclick="checkAnswer('B')"><span class="fw-bold text-warning me-3">B.</span><span id="textB"></span></button>
            <button class="option-btn" id="btnC" onclick="checkAnswer('C')"><span class="fw-bold text-warning me-3">C.</span><span id="textC"></span></button>
            <button class="option-btn" id="btnD" onclick="checkAnswer('D')"><span class="fw-bold text-warning me-3">D.</span><span id="textD"></span></button>
        </div>

        <div class="feedback-text" id="feedbackText"></div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <script>
        let currentCell = null;
        let correctOption = '';
        let myModal = null;
        
        const bgList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(bgImages));
        let currentBgIndex = 0;
        let bgTimeout = null;

        document.addEventListener("DOMContentLoaded", function() {
            myModal = new bootstrap.Modal(document.getElementById('questionModal'));
            
            if (bgList && bgList.length > 0) {
                playNextBackground();
            }
        });

        function playNextBackground() {
            if (!bgList || bgList.length === 0) return;
            const bgContainer = document.getElementById('bg-container');
            bgContainer.innerHTML = '';
            clearTimeout(bgTimeout);
            
            const bgUrl = bgList[currentBgIndex];
            const isVideo = bgUrl.toLowerCase().match(/\.(mp4|webm|ogg|mov)$/);
            
            if (isVideo) {
                const video = document.createElement('video');
                video.src = bgUrl + "?v=" + new Date().getTime();
                video.autoplay = true;
                video.muted = true;
                video.playsInline = true;
                video.style.width = '100vw';
                video.style.height = '100vh';
                video.style.objectFit = 'cover';
                
                if (bgList.length === 1) {
                    video.loop = true;
                } else {
                    video.onended = () => {
                        currentBgIndex = (currentBgIndex + 1) % bgList.length;
                        playNextBackground();
                    };
                }
                bgContainer.appendChild(video);
            } else {
                const img = document.createElement('div');
                img.style.backgroundImage = `url('${bgUrl}?v=${new Date().getTime()}')`;
                img.style.backgroundSize = 'cover';
                img.style.backgroundPosition = 'center';
                img.style.backgroundAttachment = 'fixed';
                img.style.width = '100vw';
                img.style.height = '100vh';
                bgContainer.appendChild(img);
                
                if (bgList.length > 1) {
                    bgTimeout = setTimeout(() => {
                        currentBgIndex = (currentBgIndex + 1) % bgList.length;
                        playNextBackground();
                    }, 5000); // 5 seconds for image
                }
            }
        }

        function toggleBackgroundAudio() {
            var audio = document.getElementById('globalBgAudio');
            var icon = document.getElementById('audioIcon');
            if (audio) {
                if (audio.muted || audio.paused) {
                    audio.muted = false;
                    audio.play().catch(e => console.log(e));
                    icon.innerText = '🔊';
                } else {
                    audio.muted = true;
                    icon.innerText = '🔇';
                }
            }
        }

        function openQuestion(element) {
            currentCell = element;
            const id = element.getAttribute('data-id');
            const question = element.getAttribute('data-question') || '';
            const optA = element.getAttribute('data-opt-a') || '';
            const optB = element.getAttribute('data-opt-b') || '';
            const optC = element.getAttribute('data-opt-c') || '';
            const optD = element.getAttribute('data-opt-d') || '';
            correctOption = element.getAttribute('data-correct') || '';

            document.getElementById('modalTitle').innerText = 'Câu hỏi số ' + id;
            document.getElementById('modalQuestionText').innerText = question;

            var audio = document.getElementById('globalBgAudio');
            var icon = document.getElementById('audioIcon');
            if (audio && icon) {
                icon.innerText = (audio.muted || audio.paused) ? '🔇' : '🔊';
            }
            document.getElementById('textA').innerText = optA;
            document.getElementById('textB').innerText = optB;
            document.getElementById('textC').innerText = optC;
            document.getElementById('textD').innerText = optD;
            
            // Reset buttons state
            ['A', 'B', 'C', 'D'].forEach(opt => {
                const btn = document.getElementById('btn' + opt);
                btn.className = 'option-btn'; // remove correct/wrong classes
                btn.style.backgroundColor = '';
                btn.style.borderColor = '';
                btn.disabled = false;
            });
            
            const feedback = document.getElementById('feedbackText');
            feedback.style.display = 'none';

            myModal.show();
        }

        function checkAnswer(selectedOpt) {
            const btn = document.getElementById('btn' + selectedOpt);
            const feedback = document.getElementById('feedbackText');
            feedback.style.display = 'block';

            if (selectedOpt === correctOption) {
                // Đúng
                btn.classList.add('correct');
                feedback.innerText = "🎉 CHÍNH XÁC!";
                feedback.style.color = "#4CAF50";
                
                // Disable all other buttons
                ['A', 'B', 'C', 'D'].forEach(opt => {
                    document.getElementById('btn' + opt).disabled = true;
                });

                // Mark cell as opened
                if (currentCell) {
                    currentCell.classList.add('opened');
                }
            } else {
                // Sai
                btn.classList.add('wrong');
                feedback.innerText = "❌ SAI RỒI! Hãy chọn lại.";
                feedback.style.color = "#f44336";
                
                // Remove the wrong class after animation so it can be animated again if needed
                setTimeout(() => {
                    btn.classList.remove('wrong');
                    btn.style.backgroundColor = "#c62828";
                    btn.style.borderColor = "#ef5350";
                }, 400);
            }
        }
    </script>
}
