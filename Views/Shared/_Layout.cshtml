<!DOCTYPE html>
<html lang="en">
@inject BingoGame.Services.SettingsService SettingsService
@{
    var bgAudios = SettingsService.GetBackgroundAudios();
}
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BingoGame</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/BingoGame.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3" style="background-color: #c62828;">
            <div class="container-fluid">
                <a class="navbar-brand text-white fw-bold" asp-area="" asp-controller="Home" asp-action="Index">BingoGame</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Index">Game Board</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Home" asp-action="Rules">Luật chơi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Admin" asp-action="Index">Quản lý câu hỏi</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Admin" asp-action="Appearance">Quản lý giao diện</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white" asp-area="" asp-controller="Admin" asp-action="Audio">Quản lý âm thanh</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        <button id="toggleMusicBtn" class="btn btn-link text-white p-0 ms-3" title="Tạm dừng / Mở lại nhạc" onclick="if(window.toggleMusic) window.toggleMusic();">
                            <svg id="musicIconOn" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-volume-up-fill" viewBox="0 0 16 16">
                              <path d="M11.536 14.01A8.47 8.47 0 0 0 14.026 8a8.47 8.47 0 0 0-2.49-6.01l-.708.707A7.48 7.48 0 0 1 13.025 8c0 2.071-.84 3.946-2.197 5.303z"/>
                              <path d="M10.121 12.596A6.48 6.48 0 0 0 12.025 8a6.48 6.48 0 0 0-1.904-4.596l-.707.707A5.48 5.48 0 0 1 11.025 8a5.48 5.48 0 0 1-1.61 3.89z"/>
                              <path d="M8.707 11.182A4.5 4.5 0 0 0 10.025 8a4.5 4.5 0 0 0-1.318-3.182L8 5.525A3.5 3.5 0 0 1 9.025 8 3.5 3.5 0 0 1 8 10.475zM6.717 3.55A.5.5 0 0 1 7 4v8a.5.5 0 0 1-.812.39L3.825 10.5H1.5A.5.5 0 0 1 1 10V6a.5.5 0 0 1 .5-.5h2.325l2.363-1.89a.5.5 0 0 1 .529-.06"/>
                            </svg>
                            <svg id="musicIconOff" xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-volume-mute-fill d-none" viewBox="0 0 16 16">
                              <path d="M6.717 3.55A.5.5 0 0 1 7 4v8a.5.5 0 0 1-.812.39L3.825 10.5H1.5A.5.5 0 0 1 1 10V6a.5.5 0 0 1 .5-.5h2.325l2.363-1.89a.5.5 0 0 1 .529-.06zm7.137 2.096a.5.5 0 0 1 0 .708L12.207 8l1.647 1.646a.5.5 0 0 1-.708.708L11.5 8.707l-1.646 1.647a.5.5 0 0 1-.708-.708L10.793 8 9.146 6.354a.5.5 0 1 1 .708-.708L11.5 7.293l1.646-1.647a.5.5 0 0 1 .708 0z"/>
                            </svg>
                        </button>
                        <button id="reloadMusicBtn" class="btn btn-link text-white p-0 ms-3" title="Phát lại nhạc từ bài 1" onclick="if(window.reloadMusic) window.reloadMusic();">
                            <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-arrow-clockwise" viewBox="0 0 16 16">
                                <path fill-rule="evenodd" d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
                                <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                            </svg>
                        </button>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - BingoGame - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                Swal.fire({
                    icon: 'success',
                    title: 'Thành công!',
                    text: '@Html.Raw(TempData["SuccessMessage"])',
                    showConfirmButton: false,
                    timer: 2000
                });
            });
        </script>
    }

    @if (bgAudios != null && bgAudios.Any()) {
        <audio id="globalBgAudio" autoplay>
        </audio>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var audioList = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(bgAudios));
                var audio = document.getElementById('globalBgAudio');
                
                if (audio && audioList.length > 0) {
                    var currentTrackIndex = 0;
                    var currentTrackPlayCount = 0;
                    
                    window.reloadMusic = function() {
                        currentTrackIndex = 0;
                        currentTrackPlayCount = 0;
                        sessionStorage.setItem('bgAudioCurrentIndex', '0');
                        sessionStorage.setItem('bgAudioCurrentPlayCount', '0');
                        sessionStorage.setItem('bgAudioCurrentTime', '0');
                        
                        audio.src = audioList[currentTrackIndex].Url || audioList[currentTrackIndex].url;
                        audio.currentTime = 0;
                        audio.play().catch(e => console.log('Play blocked: ', e));
                        
                        document.getElementById('musicIconOn').classList.remove('d-none');
                        document.getElementById('musicIconOff').classList.add('d-none');
                    };
                    
                    window.toggleMusic = function() {
                        if (audio.paused) {
                            audio.play().catch(e => console.log('Play blocked: ', e));
                            document.getElementById('musicIconOn').classList.remove('d-none');
                            document.getElementById('musicIconOff').classList.add('d-none');
                        } else {
                            audio.pause();
                            document.getElementById('musicIconOn').classList.add('d-none');
                            document.getElementById('musicIconOff').classList.remove('d-none');
                        }
                    };
                    
                    var savedIndex = sessionStorage.getItem('bgAudioCurrentIndex');
                    if (savedIndex !== null) {
                        var index = parseInt(savedIndex);
                        if (!isNaN(index) && index < audioList.length) {
                            currentTrackIndex = index;
                        }
                    }

                    var savedPlayCount = sessionStorage.getItem('bgAudioCurrentPlayCount');
                    if (savedPlayCount !== null) {
                        var count = parseInt(savedPlayCount);
                        if (!isNaN(count)) {
                            currentTrackPlayCount = count;
                        }
                    }

                    audio.src = audioList[currentTrackIndex].Url || audioList[currentTrackIndex].url; // Support PascalCase or camelCase

                    var savedTime = sessionStorage.getItem('bgAudioCurrentTime');
                    if (savedTime) {
                        audio.currentTime = parseFloat(savedTime);
                    }

                    var playAudio = function() {
                        audio.play().then(() => {
                            document.getElementById('musicIconOn').classList.remove('d-none');
                            document.getElementById('musicIconOff').classList.add('d-none');
                        }).catch(e => {
                            console.log('Autoplay blocked: ', e);
                            document.getElementById('musicIconOn').classList.add('d-none');
                            document.getElementById('musicIconOff').classList.remove('d-none');
                        });
                    };

                    audio.addEventListener('timeupdate', function() {
                        sessionStorage.setItem('bgAudioCurrentTime', audio.currentTime);
                        sessionStorage.setItem('bgAudioCurrentIndex', currentTrackIndex);
                        sessionStorage.setItem('bgAudioCurrentPlayCount', currentTrackPlayCount);
                    });

                    audio.addEventListener('ended', function() {
                        var maxRepeat = audioList[currentTrackIndex].RepeatCount || audioList[currentTrackIndex].repeatCount || 1;
                        currentTrackPlayCount++;

                        if (currentTrackPlayCount >= maxRepeat) {
                            currentTrackPlayCount = 0;
                            currentTrackIndex = (currentTrackIndex + 1) % audioList.length;
                            audio.src = audioList[currentTrackIndex].Url || audioList[currentTrackIndex].url;
                        }
                        
                        audio.currentTime = 0;
                        playAudio();
                    });

                    document.addEventListener('click', function() {
                        if (audio.paused) {
                            playAudio();
                        }
                    }, { once: true });
                    
                    playAudio();
                }
            });
        </script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
